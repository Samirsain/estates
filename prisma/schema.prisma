// 3% Club CRM v3.1 — Phase 1 (identity and security), Phase 2 (inventory,
// enquiries, holds, tasks) and Phase 3 (bookings, ownership shares, Payment
// Received, external references).
// Boundaries: ARCHITECTURE.md §5. Business rules: PRD.md §7–§10, §12, §14–§17, §20, §22, §24.
// No rupee column exists anywhere in this schema by design (PRD §1.2).
// Phase 4 (commission and network) and Phase 5 (cancellation, Change Plot,
// acquisition and Payment Given) complete the transactional model.

datasource db {
  provider  = "postgresql"
  // Runtime traffic goes through the Supabase transaction pooler.
  url       = env("DATABASE_URL")
  // Schema changes need a direct (non-pooled) connection.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StaffRole {
  MD
  ADMIN
  ACCOUNTS
  CRM
  MIS
  PC
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum MemberStatus {
  ACTIVE
  DEACTIVATED
}

/// PRD §14.1 — Pending: no valid number. Available: valid-format number recorded.
/// Verified: authorised staff has checked identity.
enum AadhaarStatus {
  PENDING
  AVAILABLE
  VERIFIED
}

/// PRD §14.2 — PAN Available requires a PAN Number; Not Available requires it empty.
enum PanStatus {
  NOT_AVAILABLE
  AVAILABLE
  VERIFIED
}

/// PRD §22 — one surviving Person identity; old IDs remain searchable.
enum MergeStatus {
  NONE
  SURVIVOR
  MERGED_AWAY
}

/// Immutable human identity. One Person, many capabilities (ARCHITECTURE §3.1).
model Person {
  id            String    @id @default(uuid())
  fullName      String
  /// main-PRD §18.2 — part of the final buyer details collected before
  /// Allotment or Registry. Never a document upload.
  dateOfBirth   DateTime?
  /// Contact only. Deliberately NOT unique — a mobile may be shared across
  /// Persons; a Member logs in with Member ID, never with a mobile (PRD §17.1).
  primaryMobile String
  altMobile     String?
  email         String?
  city          String?
  addressLine   String?

  // Aadhaar — protected field, never an uploaded document (PRD RD-05).
  aadhaarCipher     String? // AES-256-GCM payload
  aadhaarLastFour   String?
  /// Deterministic keyed hash so duplicates are caught without a searchable plaintext.
  aadhaarBlindIndex String?       @unique
  aadhaarStatus     AadhaarStatus @default(PENDING)

  // PAN
  panCipher     String?
  panMasked     String?
  panBlindIndex String?   @unique
  panStatus     PanStatus @default(NOT_AVAILABLE)

  // Merge foundation (PRD §22) — old records are never deleted.
  mergeStatus       MergeStatus @default(NONE)
  survivingPersonId String?
  survivingPerson   Person?     @relation("PersonMerge", fields: [survivingPersonId], references: [id])
  mergedPersons     Person[]    @relation("PersonMerge")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerProfile CustomerProfile?
  memberProfile   MemberProfile?
  staffAccount    StaffAccount?

  enquiries    Enquiry[]
  holds        Hold[]
  sourcedHolds Hold[]        @relation("HoldSourcedBy")
  holdRequests HoldRequest[]

  primaryBookings Booking[]      @relation("BookingPrimaryCustomer")
  soldBookings    Booking[]      @relation("BookingSoldBy")
  bookingParties  BookingParty[]

  commissions             CommissionRecord[]   @relation("CommissionBeneficiary")
  recoveries              Recovery[]
  acquisitionsAsSeller    Acquisition[]        @relation("AcquisitionSeller")
  acquisitionsArranged    Acquisition[]        @relation("AcquisitionArranger")
  bankDetails             BankDetail[]
  mergeRequestsAsSurvivor PersonMergeRequest[] @relation("MergeSurvivor")
  mergeRequestsAsMerged   PersonMergeRequest[] @relation("MergeMerged")
  landInquiriesSourced    LandInquiry[]        @relation("LandInquirySource")

  /// CP §58 — close relatives declared for this staff Person, and the staff this Person is a relative of.
  declaredRelatives    StaffRelative[]       @relation("StaffRelativeStaff")
  relativeOfStaff      StaffRelative[]       @relation("StaffRelativeRelative")
  staffConflictReviews StaffConflictReview[]
  circumventionReviews CircumventionReview[]

  @@index([primaryMobile])
  @@index([fullName])
}

model CustomerProfile {
  id         String @id @default(uuid())
  /// Display identity, e.g. CUS-3390. Never reused.
  customerId String @unique
  personId   String @unique
  person     Person @relation(fields: [personId], references: [id])

  customerType String?

  /// History only. CR-001 — an Enquiry decides no Direct, Invite, Royalty or
  /// Loyalty, so this Enquiry-era relationship is preserved and never read by
  /// the commission engine. Nothing writes it any more.
  originalIntroducedByMemberId String?
  originalIntroducedByMember   MemberProfile? @relation("IntroducedCustomers", fields: [originalIntroducedByMemberId], references: [id])

  /// CR-002 — the Royalty Linked Member: whoever was Sold By Member on this
  /// Customer's first qualifying purchase. Provisional while
  /// `royaltyLinkFinalAt` is null; final at 100% Payment Received or an
  /// Approved Buyback on that purchase (v2.1 §49 — a Buyback only once the
  /// purchase has 25% Payment Received). Kept for the Royalty Gift (part 2). Null against a set
  /// `royaltyLinkFirstBookingId` is CR-003's permanent "no Royalty Member":
  /// the first purchase was Sold By 3% CLUB or Sold By Customer.
  royaltyLinkedMemberId        String?
  royaltyLinkedMember          MemberProfile?            @relation("RoyaltyLinkedCustomers", fields: [royaltyLinkedMemberId], references: [id])
  royaltyLinkFirstBookingId    String?
  royaltyLinkFirstBooking      Booking?                  @relation("RoyaltyFirstPurchase", fields: [royaltyLinkFirstBookingId], references: [id])
  royaltyLinkFinalAt           DateTime?
  /// CP §41 — how the link became final: PAYMENT_100 or APPROVED_BUYBACK.
  royaltyLinkFinalRoute        RewardQualificationRoute?
  /// SSOT §74; CP §41 — the one lifetime Royalty opportunity, consumed by the
  /// Booking whose Royalty Credit it created. Null while unused.
  royaltyOpportunityConsumedAt DateTime?
  royaltyCredits               RoyaltyCredit[]

  /// v2.1 §22 — a Sold By Customer must have accepted Customer Terms before
  /// Customer-closing Loyalty can be paid. Recorded by CRM, append-only.
  termsAcceptances CustomerTermsAcceptance[]

  /// Old Customer IDs kept searchable after a merge (PRD §22).
  legacyCustomerIds String[] @default([])

  sourcedEnquiries Enquiry[] @relation("CustomerSourcedEnquiries")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([royaltyLinkedMemberId])
}

/// v2.1 §22, §79 — the Customer Terms a Customer closer accepted. The Terms
/// text is published outside the CRM; CRM records which version was accepted
/// and when. One row per acceptance, never updated in place.
model CustomerTermsAcceptance {
  id                String          @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  /// The Terms version reference, e.g. CT-2026-10.
  termsVersion      String
  /// The day the Customer accepted. Never in the future.
  acceptedOn        DateTime
  recordedByRef     String
  createdAt         DateTime        @default(now())

  @@index([customerProfileId])
}

/// Terms §2.1 — "The person accepts the applicable Terms and Privacy Notice".
/// One row per Member per published version, never updated in place: what a
/// Member agreed to and when is exactly the kind of record PRD §23.5 keeps
/// append-only.
model MemberTermsAcceptance {
  id              String        @id @default(uuid())
  memberProfileId String
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  /// The published Terms version, e.g. 2026-08-22.
  version         String
  acceptedAt      DateTime      @default(now())
  /// Recorded for a later dispute, never used to identify anyone (Privacy §5).
  ip              String?

  @@unique([memberProfileId, version])
  @@index([version])
}

model MemberProfile {
  id       String @id @default(uuid())
  /// Login identifier for the Member portal (PRD §17.1).
  memberId String @unique
  personId String @unique
  person   Person @relation(fields: [personId], references: [id])

  activationDate DateTime?
  status         MemberStatus @default(ACTIVE)

  invitedByMemberId String?
  invitedByMember   MemberProfile?  @relation("MemberNetwork", fields: [invitedByMemberId], references: [id])
  invitedMembers    MemberProfile[] @relation("MemberNetwork")

  /// A new Member has provided nothing yet, so Pending is the honest default:
  /// Not Applicable is a decision that carries a compulsory reason (PRD §19.5).
  reraStatus              ReraStatus @default(PENDING)
  reraNumber              String?
  reraExpiryDate          DateTime?
  /// Compulsory when the status is Not Applicable (PRD §19.5).
  reraNotApplicableReason String?

  /// Terms §2.1 — acceptance is part of becoming a Member, so it is recorded
  /// rather than re-asked. A new version asks again and adds its own row.
  termsAcceptances MemberTermsAcceptance[]

  /// SSOT §37, §38; CP §22 — the inviter freezes at activation (the CRM's
  /// Membership application). The introduced Member's one lifetime Reference
  /// opportunity, and the Booking that consumed it.
  inviterFrozenAt                DateTime?
  referenceOpportunityConsumedAt DateTime?
  referenceWinningBookingId      String?

  /// PRD §14.11 — a Member-level hold affects every unpaid record.
  commissionHold       Boolean @default(false)
  commissionHoldReason String?

  legacyMemberIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portalAccount          PortalAccount?
  introducedCustomers    CustomerProfile[] @relation("IntroducedCustomers")
  /// CR-002 — the Customers whose first qualifying purchase this Member closed.
  royaltyLinkedCustomers CustomerProfile[] @relation("RoyaltyLinkedCustomers")
  /// SSOT §75 — the Royalty Credits (Gift entitlements) this Member owns.
  royaltyCredits         RoyaltyCredit[]
  tripCredits            TripCredit[]      @relation("TripCreditOwner")
  referenceCreditsGiven  TripCredit[]      @relation("TripCreditIntroduced")
  tripBuckets            TripBucket[]
  tripRewards            TripReward[]
  sourcedEnquiries       Enquiry[]         @relation("MemberSourcedEnquiries")
  holdRequests           HoldRequest[]
}

model StaffAccount {
  id             String @id @default(uuid())
  staffAccountId String @unique
  personId       String @unique
  person         Person @relation(fields: [personId], references: [id])

  role             StaffRole
  /// Extra scoped grants on top of the role baseline. Deny by default.
  extraPermissions String[]  @default([])

  status       AccountStatus @default(ACTIVE)
  passwordHash String

  /// Bumped on password reset / emergency disable to invalidate every session.
  sessionVersion Int       @default(1)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// PRD §17.2 — emergency disable blocks login immediately and queues the
  /// open work for reassignment. The historical actor identity never changes.
  disabledAt        DateTime?
  disabledByRef     String?
  disabledReason    String?
  emergencyDisabled Boolean   @default(false)

  assignedEnquiries     Enquiry[]
  assignedTasks         Task[]        @relation("TaskAssignee")
  assignedLandInquiries LandInquiry[] @relation("LandInquiryAssignee")

  @@index([role, status])
}

model PortalAccount {
  id              String        @id @default(uuid())
  memberProfileId String        @unique
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id])
  /// Equals the Member ID. Mobile alone is never sufficient (PRD §17.1).
  loginId         String        @unique
  passwordHash    String
  status          AccountStatus @default(ACTIVE)

  sessionVersion Int       @default(1)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// PRD §19 / ARCHITECTURE §8 — a repeated key returns the original result.
model IdempotencyRecord {
  id          String   @id @default(uuid())
  key         String   @unique
  actorRef    String
  operation   String
  requestHash String
  resultJson  Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

/// Append-only. Corrections write a new event; nothing is updated or deleted.
model AuditEvent {
  id            String   @id @default(uuid())
  at            DateTime @default(now())
  actorRef      String
  actorRole     String?
  entity        String
  entityId      String
  action        String
  /// Masked before/after payloads. Passwords and secrets never reach audit (PRD §17.1).
  beforeMasked  Json?
  afterMasked   Json?
  reason        String?
  correlationId String?
  ip            String?

  @@index([entity, entityId])
  @@index([at])
}

// ===========================================================================
// Phase 2 — Projects, Plot Inventory, Enquiries, Holds and Tasks
// ===========================================================================

/// PRD §16.1. "Available (Resale)" is a derived display condition, never a status.
enum ProjectStatus {
  SETUP_NOT_ACTIVE
  ACTIVE
  SOLD_OUT
  COMPLETED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  AGRICULTURAL
  /// No longer offered on the form, and refused by createProjectAction. Kept
  /// because Projects created before that still carry it.
  MIXED
}

enum PlotType {
  RESIDENTIAL
  COMMERCIAL
  INFORMAL_SECTOR
}

/// DESIGN §4.2 — the exact visible status. Process messages are separate.
enum PlotStatus {
  NOT_AVAILABLE
  AVAILABLE
  HOLD
  WAITING_FOR_BOOKING_APPROVAL
  BOOKED
  PAYMENT_COMPLETED
  REFUND_PENDING
  DELIVERED
}

/// DESIGN §7.4. NOT_FOR_SALE and PLEDGE keep a returning Plot Not Available (PRD §15).
enum PlotRestriction {
  NONE
  NOT_YET_RELEASED
  NOT_FOR_SALE
  PLEDGE
}

enum BoundarySide {
  NORTH
  SOUTH
  EAST
  WEST
}

/// What lies on one side of a Plot. Only the three Plot kinds close a side; the
/// rest leave it open (see isOpenSide in src/lib/domain/inventory.ts).
enum BoundaryKind {
  ROAD
  PLOT
  COMMERCIAL
  INFORMAL_SECTOR
  PARK
  PLAYGROUND
  FACILITIES
  PUBLIC_UTILITY
  OTHER
}

/// The whole PLC vocabulary. A Project sets the percentages; it does not invent
/// categories, and no code is typed anywhere (PLC spec §2.3, §3.3).
enum PlcCategory {
  ROAD_WIDTH
  OPEN_SIDES
  PARK_FACING
  PLAYGROUND_FACING
}

enum EnquiryStatus {
  ACTIVE
  BOOKED
  CLOSED
}

/// Source Person is required for BY_MEMBER and BY_CUSTOMER (DESIGN §8.2).
enum EnquirySource {
  /// Online, Advertisement or Website — one arrival, three names for it.
  ONLINE
  SITE_VISIT
  BY_MEMBER
  BY_CUSTOMER
  EXISTING_CUSTOMER
  /// Direct / Walk-in.
  DIRECT
}

/// DESIGN §8.4 — follow-up outcomes.
enum FollowUpOutcome {
  CONTACTED
  NOT_ANSWERED
  CALL_LATER
  SITE_VISIT_PLANNED
  BOOKING_DISCUSSION
}

enum HoldStatus {
  ACTIVE
  /// Booking Request submitted — the remaining duration is frozen, not running
  /// (PRD §10.5). Rejection restores it; approval ends the Hold permanently.
  FROZEN
  EXPIRED
  CANCELLED
  CONVERTED_TO_BOOKING
}

enum ExtensionStatus {
  PENDING
  APPROVED
  REJECTED
  /// The Hold expired before a decision; the old request can never revive it (PRD §8.5).
  EXPIRED
}

enum HoldRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum TaskStatus {
  PENDING
  COMPLETED
}

model Project {
  id          String        @id @default(uuid())
  projectCode String        @unique
  name        String
  developer   String?
  location    String?
  /// A map link. Prose lives in `location`; this is the URL, http(s) only.
  locationUrl String?
  /// Where the structure and layout documents live, http(s) only.
  driveUrl    String?
  /// The 3D visuals or walkthrough, wherever they are hosted. http(s) only.
  renderUrl   String?
  city        String?
  /// One amenity per line. Rendered as bullets on the Project card.
  amenities   String?
  type        ProjectType
  status      ProjectStatus @default(SETUP_NOT_ACTIVE)

  /// External acquisition container (PRD §11.6). A normal development Project is false.
  isExternalResaleGroup Boolean @default(false)

  reraNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plots                Plot[]
  plcRuleVersions      PlcRuleVersion[]
  commissionVersions   ProjectCommissionVersion[]
  enquiries            Enquiry[]
  bookings             Booking[]
  externalAcquisitions Acquisition[]              @relation("ExternalResaleGroup")
}

/// SSOT §12–§16; CP §7, §92 — a Project's Direct and Loyalty terms. Every change
/// is a new version; Admin prepares, MD approves, and a version is never edited
/// after it leaves Draft. APPROVED waits for a later Effective from.
enum CommissionVersionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  SUPERSEDED
  REJECTED
}

model ProjectCommissionVersion {
  id        String                  @id @default(uuid())
  projectId String
  project   Project                 @relation(fields: [projectId], references: [id])
  /// 1, 2, 3 … per Project; never reused.
  version   Int
  status    CommissionVersionStatus @default(DRAFT)

  /// v2.1 §13 — Enabled ⇔ a rate. A benefit not offered is Disabled, never 0%.
  directEnabled          Boolean
  directPercent          Decimal? @db.Decimal(7, 4)
  /// v2.1 §21 — one rate for both Loyalty routes.
  loyaltyEnabled         Boolean
  loyaltyPercent         Decimal? @db.Decimal(7, 4)
  /// v2.1 §13 — the MD exception's written commercial reason.
  loyaltyExceptionReason String?

  /// SSOT §12.3, §40; CP §7.1 — the Project Trip Programme in this version.
  /// Disabled carries nothing. The code is the programme's identity across
  /// versions (CP §25.3); cut-off and wind-down are its closure (CP §36).
  tripEnabled             Boolean             @default(false)
  tripTotalTarget         Int?
  tripMinOwnCredits       Int?
  tripMaxReferenceCredits Int?
  tripProgrammeCode       String?
  tripProgrammeVersionRef String?
  tripTermsVersionRef     String?
  tripCutOffAt            DateTime?
  tripWindDownAt          DateTime?
  /// CP §7.4 — reviewed outside the CRM; only the fact, who and when.
  economicsReviewedByRef  String?
  economicsReviewedAt     DateTime?
  tripInventoryRules      TripInventoryRule[]

  reason        String
  preparedByRef String
  preparedAt    DateTime  @default(now())
  submittedAt   DateTime?
  decidedByRef  String?
  decidedAt     DateTime?
  decisionNote  String?
  /// CP §7.1, §8 — Admin may propose a future time on the Draft; otherwise set
  /// at MD approval. Never earlier than the approval itself (SSOT §16).
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  bookings    Booking[]
  tripCredits TripCredit[]
  tripBuckets TripBucket[]

  @@unique([projectId, version])
}

/// CP §9; SSOT §44 — a Plot's place in a version's Trip Programme. Every Plot
/// is eligible unless excluded here; a child Plot may share its parent's
/// credit pool. Frozen with the version.
model TripInventoryRule {
  id                     String                   @id @default(uuid())
  settingsVersionId      String
  settingsVersion        ProjectCommissionVersion @relation(fields: [settingsVersionId], references: [id], onDelete: Cascade)
  plotId                 String
  eligible               Boolean
  parentCreditPoolPlotId String?
  reason                 String

  @@unique([settingsVersionId, plotId])
}

/// PLC spec §3.1 — a version is Draft until it is published. Publishing
/// supersedes the prior published version; nothing is edited in place (§3.4).
enum PlcVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

/// PRD §16.3 — PLC is percentage only and each distinct component is charged once.
model PlcRuleVersion {
  id        String           @id @default(uuid())
  projectId String
  project   Project          @relation(fields: [projectId], references: [id])
  version   Int
  /// Available / Not Active inventory uses the one PUBLISHED version; Holds and
  /// Bookings use frozen snapshots.
  status    PlcVersionStatus @default(DRAFT)

  /// Set at publish, not at draft creation — a draft has no effective date.
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdBy   String?
  createdAt   DateTime  @default(now())
  publishedBy String?
  publishedAt DateTime?
  reason      String?

  /// PLC spec §3.4 — the old version becomes historical, never deleted.
  supersededById String?         @unique
  supersededBy   PlcRuleVersion? @relation("PlcVersionSupersession", fields: [supersededById], references: [id])
  supersedes     PlcRuleVersion? @relation("PlcVersionSupersession")

  components PlcComponent[]
  snapshots  PlcSnapshot[]

  @@unique([projectId, version])
}

model PlcComponent {
  id            String         @id @default(uuid())
  ruleVersionId String
  ruleVersion   PlcRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)
  /// The stable key. The same category on multiple sides is charged once, and a
  /// banded category charges only the highest band the Plot reaches.
  category      PlcCategory
  /// Feet for ROAD_WIDTH, a count of open sides for OPEN_SIDES, null otherwise.
  /// The displayed label is generated from it, never stored.
  threshold     Decimal?       @db.Decimal(8, 2)
  percent       Decimal        @db.Decimal(7, 4)
  remark        String?

  @@unique([ruleVersionId, category, threshold])
}

/// Immutable frozen copy taken at Hold, Booking Request or Change Plot.
/// PLC spec §7.2 — a correction never rewrites this row. It creates a corrected
/// snapshot and supersedes this one, which stays readable as History.
model PlcSnapshot {
  id            String         @id @default(uuid())
  ruleVersionId String
  ruleVersion   PlcRuleVersion @relation(fields: [ruleVersionId], references: [id])
  plotId        String
  plot          Plot           @relation(fields: [plotId], references: [id])
  /// [{ category, label, percent, evidence }] exactly as charged, with the
  /// sides that qualified (PLC spec §7.1).
  components    Json
  totalPercent  Decimal        @db.Decimal(7, 4)
  frozenAt      DateTime       @default(now())

  /// False once superseded by a correction, or once the Change Plot that froze
  /// it was rejected (PLC spec §10.3).
  isCurrent      Boolean      @default(true)
  supersededById String?      @unique
  supersededBy   PlcSnapshot? @relation("PlcSnapshotSupersession", fields: [supersededById], references: [id])
  supersedes     PlcSnapshot? @relation("PlcSnapshotSupersession")

  /// Compulsory on a corrected snapshot (PLC spec §11.1).
  correctionReason String?
  correctedBy      String?

  holds              Hold[]
  bookings           Booking[]
  changePlotRequests ChangePlotRequest[]

  @@index([plotId, isCurrent])
}

model Plot {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  plotType   PlotType
  plotNumber String

  // Dimensions. Width and Length are required for a regular Plot; an irregular
  // Plot uses the override and a compulsory reason (PRD §16.2).
  widthFt         Decimal? @db.Decimal(10, 3)
  lengthFt        Decimal? @db.Decimal(10, 3)
  exactAreaSqFt   Decimal? @db.Decimal(12, 4)
  exactAreaReason String?
  /// Persisted so inventory lists and reports never recompute inconsistently.
  areaSqFt        Decimal  @db.Decimal(12, 4)
  areaSqYd        Decimal  @db.Decimal(12, 4)
  areaSqM         Decimal  @db.Decimal(12, 4)

  /// No PLC applicability is stored here. It derives from the Plot's own
  /// boundaries every time it is read (PLC spec §4.1, §4.3), so correcting a
  /// boundary corrects the PLC with it. Park Facing is one of those boundaries
  /// rather than a separate flag that could contradict them.

  status            PlotStatus      @default(NOT_AVAILABLE)
  restriction       PlotRestriction @default(NOT_YET_RELEASED)
  restrictionReason String?
  /// Buyback / Purchase for Resale tag. Independent of availability (PRD §15).
  isResale          Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boundaries     PlotBoundary[]
  holds          Hold[]
  holdRequests   HoldRequest[]
  plcSnapshots   PlcSnapshot[]
  events         PlotEvent[]
  enquiries      Enquiry[]
  bookings       Booking[]
  acquisitions   Acquisition[]
  changePlotFrom ChangePlotRequest[] @relation("ChangePlotFrom")
  changePlotTo   ChangePlotRequest[] @relation("ChangePlotTo")

  /// PRD §16.2 — Plot uniqueness is Project + Plot Type + Plot Number.
  @@unique([projectId, plotType, plotNumber])
  @@index([status])
}

model PlotBoundary {
  id          String       @id @default(uuid())
  plotId      String
  plot        Plot         @relation(fields: [plotId], references: [id], onDelete: Cascade)
  side        BoundarySide
  kind        BoundaryKind
  /// Required when kind = ROAD — it decides the PLC band.
  roadWidthFt Decimal?     @db.Decimal(8, 2)
  /// What is on that side, when it is worth naming: the adjacent Plot Number,
  /// the park or facility number, and so on. Optional for every kind.
  reference   String?

  @@unique([plotId, side])
}

/// Append-only Plot status and restriction history (ARCHITECTURE §3.2).
model PlotEvent {
  id     String @id @default(uuid())
  plotId String
  plot   Plot   @relation(fields: [plotId], references: [id])

  at              DateTime         @default(now())
  actorRef        String
  action          String
  fromStatus      PlotStatus?
  toStatus        PlotStatus?
  fromRestriction PlotRestriction?
  toRestriction   PlotRestriction?
  reason          String?

  @@index([plotId, at])
}

model Enquiry {
  id              String  @id @default(uuid())
  enquiryNo       String  @unique
  personId        String
  person          Person  @relation(fields: [personId], references: [id])
  projectId       String
  project         Project @relation(fields: [projectId], references: [id])
  /// Optional — a Plot-wise Enquiry stays a separate record (PRD §7.1).
  plotId          String?
  plot            Plot?   @relation(fields: [plotId], references: [id])
  /// What they asked for when no Plot in inventory matches it — "40 × 60
  /// corner, west facing". Free text on purpose: it is a requirement, not a
  /// record, and it never allocates or blocks anything.
  plotRequirement String?

  source           EnquirySource
  sourceMemberId   String?
  sourceMember     MemberProfile?   @relation("MemberSourcedEnquiries", fields: [sourceMemberId], references: [id])
  sourceCustomerId String?
  sourceCustomer   CustomerProfile? @relation("CustomerSourcedEnquiries", fields: [sourceCustomerId], references: [id])

  assignedStaffId String?
  assignedStaff   StaffAccount? @relation(fields: [assignedStaffId], references: [id])

  status            EnquiryStatus @default(ACTIVE)
  closeReason       String?
  remark            String?
  /// PRD §17.2 — awaiting reassignment after an emergency disable.
  needsReassignment Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  followUps EnquiryFollowUp[]
  holds     Hold[]
  bookings  Booking[]

  @@index([personId, status])
  @@index([projectId, status])
}

/// Append-only follow-up history. One Pending task per Enquiry is reused (PRD §7.1).
model EnquiryFollowUp {
  id        String          @id @default(uuid())
  enquiryId String
  enquiry   Enquiry         @relation(fields: [enquiryId], references: [id])
  at        DateTime        @default(now())
  actorRef  String
  outcome   FollowUpOutcome
  remark    String?
  nextAt    DateTime?

  @@index([enquiryId, at])
}

model Hold {
  id       String @id @default(uuid())
  plotId   String
  plot     Plot   @relation(fields: [plotId], references: [id])
  /// The actual Person. Anonymous Member Holds are prohibited (PRD §8.1).
  personId String
  person   Person @relation(fields: [personId], references: [id])

  enquiryId      String?
  enquiry        Enquiry? @relation(fields: [enquiryId], references: [id])
  /// Set when the Hold originated from a Member Hold Request.
  sourceMemberId String?

  /// Who got the Hold done, in the Booking's own three answers (PRD 11.4):
  /// the 3% Club, a Member, or a Customer. `sourceMemberId` above stays what it
  /// always was - the Member Hold Request a Hold arrived through - while this
  /// is the credit, which a walk-in Hold carries just as much as a portal one.
  sourcedByType     SoldByType @default(THREE_PERCENT_CLUB)
  sourcedByPersonId String?
  sourcedByPerson   Person?    @relation("HoldSourcedBy", fields: [sourcedByPersonId], references: [id])

  responsibleStaffId String?

  startsAt    DateTime   @default(now())
  expiresAt   DateTime
  status      HoldStatus @default(ACTIVE)
  closedAt    DateTime?
  closeReason String?

  plcSnapshotId String?
  plcSnapshot   PlcSnapshot? @relation(fields: [plcSnapshotId], references: [id])

  extensionCount Int @default(0)

  /// Milliseconds left when the Hold was frozen for a Booking Request. Restored
  /// exactly on Accounts rejection (PRD §10.5).
  frozenRemainingMs Int?
  frozenAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  extensionRequests HoldExtensionRequest[]
  bookings          Booking[]

  @@index([plotId, status])
  @@index([personId, status])
  @@index([status, expiresAt])
  @@index([sourcedByPersonId])
}

model HoldExtensionRequest {
  id     String @id @default(uuid())
  holdId String
  hold   Hold   @relation(fields: [holdId], references: [id])

  requestedByRef String
  reason         String
  /// The first extension is CRM's; any further extension needs Admin (PRD §8.5).
  requiresAdmin  Boolean
  requestedHours Int

  status       ExtensionStatus @default(PENDING)
  decidedByRef String?
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())

  @@index([holdId, status])
}

model HoldRequest {
  id       String        @id @default(uuid())
  memberId String
  member   MemberProfile @relation(fields: [memberId], references: [id])
  /// The actual Customer/Person the Member is requesting for (PRD §8.1).
  personId String
  person   Person        @relation(fields: [personId], references: [id])
  plotId   String
  plot     Plot          @relation(fields: [plotId], references: [id])

  createdAt       DateTime          @default(now())
  /// End of the working day, or the next working day when created after cut-off.
  expiresAt       DateTime
  status          HoldRequestStatus @default(PENDING)
  decidedAt       DateTime?
  decidedByRef    String?
  decisionNote    String?
  resultingHoldId String?

  @@index([plotId, status])
  @@index([personId, status])
  @@index([status, expiresAt])
}

/// PRD §20 — duplicate prevention key is Record + Purpose.
model Task {
  id         String @id @default(uuid())
  taskNo     String @unique
  recordKind String
  recordId   String
  recordName String
  purpose    String
  title      String

  assigneeStaffId String?
  assigneeStaff   StaffAccount? @relation("TaskAssignee", fields: [assigneeStaffId], references: [id])
  assigneeRole    StaffRole

  dueAt             DateTime
  urgent            Boolean    @default(false)
  status            TaskStatus @default(PENDING)
  latestResult      String?
  /// Approve / Reject happens on the record's review snapshot, not on the row.
  decision          Boolean    @default(false)
  revisions         Int        @default(0)
  recurrence        String     @default("NONE")
  origin            String     @default("SYSTEM")
  /// PRD §17.2 — in the Unassigned Review queue after an emergency disable.
  needsReassignment Boolean    @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  events TaskEvent[]

  @@index([status, dueAt])
  @@index([assigneeRole, status])
}

/// Assignment, revision, escalation and automatic closure are all audited (PRD §20).
model TaskEvent {
  id       String    @id @default(uuid())
  taskId   String
  task     Task      @relation(fields: [taskId], references: [id])
  at       DateTime  @default(now())
  actorRef String
  action   String
  detail   String?
  fromDue  DateTime?
  toDue    DateTime?

  @@index([taskId, at])
}

// ===========================================================================
// Phase 3 — Booking Requests, Approved Bookings, Ownership Shares,
//           Payment Received and External References
// ===========================================================================

/// PRD §24 status catalogue. The request stage and the approved Booking share
/// one row: `requestNo` exists from submission, `bookingNumber` only after
/// Accounts approval (PRD §5.2).
enum BookingStatus {
  REQUEST_PENDING
  REQUEST_REJECTED
  REQUEST_CANCELLED
  BOOKED
  PAYMENT_COMPLETED
  REFUND_PENDING
  CANCELLED
  DELIVERED
  /// main-PRD §17.9 — the old sale after an approved Buyback: closed history,
  /// with the previous Customer removed from the active allocation.
  BUYBACK_COMPLETED
}

/// ARCHITECTURE §6.3 — only one of these may be active for a Booking at a time.
enum BookingProcess {
  NONE
  REFUND_PENDING
  CHANGE_PLOT_PENDING
  BUYBACK_PENDING
  PRIMARY_CUSTOMER_CHANGE_UNDER_REVIEW
  SOLD_BY_CORRECTION_UNDER_REVIEW
  MANAGEMENT_ACTION_REQUIRED
}

/// AC-01 — the buyer's standing at Accounts approval, frozen for the life of the
/// Booking. A Customer who later activates as a Member never turns their earlier
/// approved Bookings into Member business.
enum BookingClassification {
  CUSTOMER
  MEMBER
}

/// PRD §11.3 — separate from Enquiry Source. The closer controls commission.
enum SoldByType {
  THREE_PERCENT_CLUB
  MEMBER
  CUSTOMER
}

enum PartyRole {
  PRIMARY
  ADDITIONAL
}

/// PRD §13.3 — the final registration buyer may differ from the commercial
/// Booking Customer, and both must remain distinguishable.
enum PartyKind {
  COMMERCIAL
  FINAL_REGISTRATION
}

/// Shared review status for Booking Request versions, schedule revisions
/// and Primary Customer changes.
enum ReviewDecision {
  PENDING
  APPROVED
  REJECTED
  /// The maker withdrew the version before a decision (PRD §9.1, §9.2).
  CANCELLED
}

/// PRD §11.5. §9.4 — PAYMENT_NOT_RECEIVED is valid only where the request
/// claimed a payment Accounts could not verify, never merely because it is 0%.
enum BookingRejectReason {
  PAYMENT_SCHEDULE_INCORRECT
  INCOMPLETE_DETAILS
  PAYMENT_NOT_RECEIVED
  OTHER
}

enum ScheduleStatus {
  /// Awaiting Accounts approval of a revision (PRD §10.2).
  PENDING
  ACTIVE
  SUPERSEDED
  REJECTED
}

/// PRD §24 — the original entry is never deleted; a correction supersedes it.
enum EntryStatus {
  CONFIRMED
  SUPERSEDED
}

/// PRD §24 — one correction pattern for every approved external reference.
enum ReferencePurpose {
  PAYMENT_RECEIVED
  PAYMENT_GIVEN
  REFUND
  COMMISSION
  BUYBACK
  OTHER
}

enum ReferenceStatus {
  ACTIVE
  SUPERSEDED
}

model Booking {
  id            String  @id @default(uuid())
  /// Temporary pre-approval identifier, e.g. REQ-000123 (PRD §5.2).
  requestNo     String  @unique
  /// Permanent, created only on Accounts approval. Never reused.
  bookingNumber String? @unique

  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  plotId    String
  plot      Plot    @relation(fields: [plotId], references: [id])

  /// Commercial Booking Customer. Changing it runs through PrimaryCustomerChange.
  primaryPersonId String
  primaryPerson   Person @relation("BookingPrimaryCustomer", fields: [primaryPersonId], references: [id])

  soldByType     SoldByType
  /// Required for MEMBER and CUSTOMER; null for a 3% Club direct close.
  soldByPersonId String?
  soldByPerson   Person?    @relation("BookingSoldBy", fields: [soldByPersonId], references: [id])

  bookingDate  DateTime
  customerType String?
  remark       String?

  /// AC-01, v2.1 §20 — whether the Primary Customer was an Active Member,
  /// frozen with each Booking Request version and permanent after approval.
  originalClassification BookingClassification?

  /// v2.1 §15, §16 — the exact Project commission version frozen with the
  /// Booking Request version Accounts approves. Never re-derived from dates.
  commissionVersionId       String?
  commissionVersion         ProjectCommissionVersion? @relation(fields: [commissionVersionId], references: [id])
  /// v2.1 §24 — the Person who would earn Loyalty held a Deactivated Member
  /// capability when the request was submitted. Re-read on a Sold By Correction.
  loyaltySubjectDeactivated Boolean                   @default(false)

  /// SSOT §76; CP §10, §46 — the Royalty Gift Programme Version live when the
  /// Booking Request version Accounts approves was submitted. Null when none was.
  royaltyProgrammeVersionId String?
  royaltyProgrammeVersion   RoyaltyProgrammeVersion? @relation(fields: [royaltyProgrammeVersionId], references: [id])
  royaltyCredit             RoyaltyCredit?
  tripCredits               TripCredit[]

  /// Set when the request came from a Hold, so a rejection can restore the
  /// frozen remainder to the exact Hold it paused (PRD §10.5).
  holdId    String?
  hold      Hold?    @relation(fields: [holdId], references: [id])
  enquiryId String?
  enquiry   Enquiry? @relation(fields: [enquiryId], references: [id])

  /// Frozen at submission and permanent after approval (PRD §9.1).
  plcSnapshotId String?
  plcSnapshot   PlcSnapshot? @relation(fields: [plcSnapshotId], references: [id])

  status        BookingStatus  @default(REQUEST_PENDING)
  activeProcess BookingProcess @default(NONE)

  /// Cumulative verified Payment Received. Never above 100% (PRD §10.4).
  paymentReceivedPercent Decimal @default(0) @db.Decimal(7, 4)

  submittedByRef String
  submittedAt    DateTime  @default(now())
  approvedByRef  String?
  approvedAt     DateTime?
  closedAt       DateTime?
  closeReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewVersions         BookingReviewVersion[]
  parties                BookingParty[]
  commissions            CommissionRecord[]
  scheduleVersions       PaymentScheduleVersion[]
  paymentEntries         PaymentReceivedEntry[]
  events                 BookingEvent[]
  customerChanges        PrimaryCustomerChange[]
  soldByCorrections      SoldByCorrection[]
  cancellations          CancellationRequest[]
  changePlotRequests     ChangePlotRequest[]
  buybacks               Acquisition[]            @relation("BuybackSource")
  royaltyLinkedCustomers CustomerProfile[]        @relation("RoyaltyFirstPurchase")
  completions            BookingCompletion[]

  @@index([status])
  @@index([primaryPersonId, status])
  @@index([plotId, status])
}

/// PRD §9.1 — the immutable submission snapshot. While Waiting for Booking
/// Approval nothing here may be edited; a change cancels this version and
/// creates the next one.
model BookingReviewVersion {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])
  version   Int

  /// The complete frozen payload: parties and shares, Project/Plot, PLC
  /// snapshot, Sold By and beneficiary, Booking Date, Customer Type, payment
  /// schedule and remark.
  snapshot Json

  submittedByRef String
  submittedAt    DateTime @default(now())

  status       ReviewDecision       @default(PENDING)
  decidedByRef String?
  decidedAt    DateTime?
  rejectReason BookingRejectReason?
  decisionNote String?

  @@unique([bookingId, version])
  @@index([status])
}

/// PRD §12.1 — one Primary Customer; a single final buyer may omit the share
/// and is treated as 100%. Share changes are effective-dated, never overwritten.
model BookingParty {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])
  personId  String
  person    Person  @relation(fields: [personId], references: [id])

  role         PartyRole
  kind         PartyKind @default(COMMERCIAL)
  /// Null only where this is the sole buyer of its kind (treated as 100%).
  sharePercent Decimal?  @db.Decimal(7, 4)

  effectiveFrom DateTime  @default(now())
  /// Null means current. A superseded row keeps its old share for History.
  effectiveTo   DateTime?
  changeReason  String?
  actorRef      String

  @@index([bookingId, kind, effectiveTo])
}

/// PRD §10.2 — received portions stay locked; only the unpaid remainder may be
/// split, combined or moved, and Accounts approves the revision.
///
/// PRD §11.2 — "Payment Given mirrors the protected mechanics of Payment
/// Received", so one schedule model serves both sides rather than a duplicate
/// that would drift. The entries stay in separate tables, which is what the
/// separate-datasets boundary in PRD §1.2 and §21 is about.
model PaymentScheduleVersion {
  id            String       @id @default(uuid())
  bookingId     String?
  booking       Booking?     @relation(fields: [bookingId], references: [id])
  /// Exactly one of bookingId or acquisitionId is set (see constraints.sql).
  acquisitionId String?
  acquisition   Acquisition? @relation(fields: [acquisitionId], references: [id])
  version       Int

  status       ScheduleStatus @default(PENDING)
  reason       String?
  createdByRef String
  createdAt    DateTime       @default(now())
  decidedByRef String?
  decidedAt    DateTime?
  decisionNote String?

  instalments PaymentInstalment[]

  @@unique([bookingId, version])
  @@unique([acquisitionId, version])
}

/// PRD §10.1 — Upcoming / Received / Overdue are derived from Remaining and the
/// due date. There is no stored Partially Received status.
model PaymentInstalment {
  id                String                 @id @default(uuid())
  scheduleVersionId String
  scheduleVersion   PaymentScheduleVersion @relation(fields: [scheduleVersionId], references: [id], onDelete: Cascade)

  seq              Int
  scheduledPercent Decimal  @db.Decimal(7, 4)
  dueDate          DateTime
  /// Carried forward unchanged when a revision creates the next version.
  receivedPercent  Decimal  @default(0) @db.Decimal(7, 4)

  @@unique([scheduleVersionId, seq])
}

/// PRD §12.2, §12.6 — incremental, never cumulative. A correction supersedes
/// the original and links to it; nothing is deleted.
model PaymentReceivedEntry {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  percent    Decimal  @db.Decimal(7, 4)
  /// Operator-entered action date. Cannot be future-dated (PRD §10.5).
  paidOn     DateTime
  /// System entry timestamp, kept separate from the action date (PRD §24).
  recordedAt DateTime @default(now())

  externalReferenceId String            @unique
  externalReference   ExternalReference @relation(fields: [externalReferenceId], references: [id])

  /// [{ instalmentId, percent }] — allocation is oldest unpaid first (PRD §12.1).
  allocations Json

  status          EntryStatus           @default(CONFIRMED)
  /// Set on the replacement entry, pointing at the entry it corrects.
  correctsEntryId String?               @unique
  correctsEntry   PaymentReceivedEntry? @relation("PaymentCorrection", fields: [correctsEntryId], references: [id])
  correctedBy     PaymentReceivedEntry? @relation("PaymentCorrection")

  confirmedByRef String
  reason         String?
  remark         String?

  /// SSOT §22; CP §15 — recorded when someone other than the named buyer paid:
  /// who paid, and their reference. Optional; kept for Accounts review only.
  payerName      String?
  payerReference String?

  @@index([bookingId, status])
}

/// PRD §24 / §10.3 — one active reference value is globally unique across
/// Payment Received and Payment Given after normalisation.
model ExternalReference {
  id            String           @id @default(uuid())
  rawValue      String
  /// Trimmed, collapsed whitespace, upper-cased.
  normalisedKey String
  purpose       ReferencePurpose

  /// Operator-entered action date, separate from the system entry timestamp.
  actionDate DateTime
  recordedAt DateTime @default(now())

  status     ReferenceStatus    @default(ACTIVE)
  /// The superseded reference this one replaces.
  replacesId String?            @unique
  replaces   ExternalReference? @relation("ReferenceSupersession", fields: [replacesId], references: [id])
  replacedBy ExternalReference? @relation("ReferenceSupersession")

  reason   String?
  actorRef String

  paymentReceivedEntry PaymentReceivedEntry?
  paymentGivenEntry    PaymentGivenEntry?
  commissionRecord     CommissionRecord?
  cancellationRequest  CancellationRequest?

  @@index([normalisedKey])
  @@index([purpose, status])
}

/// PRD §12.3 — the old Customer stays official until Accounts approves.
model PrimaryCustomerChange {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  fromPersonId String
  toPersonId   String

  reason         String
  requestedByRef String
  requestedAt    DateTime @default(now())

  status       ReviewDecision @default(PENDING)
  decidedByRef String?
  decidedAt    DateTime?
  decisionNote String?

  @@index([bookingId, status])
}

/// PRD §6.10 — the attribution correction. Admin/MD approves the change, then
/// Accounts reviews the commission impact; Booking and Payment history are
/// never touched by it.
model SoldByCorrection {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  fromSoldByType     SoldByType
  fromSoldByPersonId String?
  toSoldByType       SoldByType
  toSoldByPersonId   String?

  reason         String
  supportingNote String
  requestedByRef String
  requestedAt    DateTime @default(now())

  status       ReviewDecision @default(PENDING)
  decidedByRef String?
  decidedAt    DateTime?
  decisionNote String?

  /// PRD §6.10 step 4 — Accounts reviews the impact after the approval.
  accountsReviewedByRef String?
  accountsReviewedAt    DateTime?
  accountsNote          String?

  @@index([bookingId, status])
}

/// Append-only Booking history for the record timeline (DESIGN §5.3).
model BookingEvent {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  at         DateTime       @default(now())
  actorRef   String
  action     String
  fromStatus BookingStatus?
  toStatus   BookingStatus?
  detail     Json?
  reason     String?

  @@index([bookingId, at])
}

// ===========================================================================
// Phase 4 — Commission and Network Engine
// PRD §6, §13, §14; main-PRD §14. Percentages only, never a payout amount.
// ===========================================================================

enum CommissionType {
  DIRECT
  LOYALTY
  /// Acquisition-side, separate from Direct and Loyalty (v2.1 §63).
  BUYING
}

/// One current record per Booking + commission type + beneficiary role (PRD §6.9).
enum BeneficiaryRole {
  SELLING_MEMBER
  CLOSING_CUSTOMER
  REPEAT_PURCHASE_CUSTOMER
  ACQUISITION_ARRANGER
}

/// PRD §14.8 — eligibility and payment are separate axes.
enum EligibilityState {
  MILESTONE_PENDING
  READY
  ON_HOLD
}

enum CommissionPaymentState {
  NOT_PAID
  PAID
  /// Processed before eligibility was Ready; the remarks are compulsory.
  PAID_EARLY
  ACCOUNTS_ADJUSTMENT_REQUIRED
  CANCELLED
}

/// PRD §14.8 — the controlled hold reasons. Nothing else may hold a record.
enum CommissionHoldReason {
  AADHAAR_PENDING
  BANK_VERIFICATION_PENDING
  RERA_PENDING
  RERA_EXPIRED
  MEMBER_COMMISSION_HOLD
  MEMBER_DEACTIVATED
  REFUND_PENDING
  CHANGE_PLOT_PENDING
  BUYBACK_PENDING
  PAYMENT_PENDING
  /// v2.1 §22, §77 — the Customer closer's Aadhaar is not Verified yet.
  CLOSER_KYC_PENDING
  /// v2.1 §22 — the Customer closer has not accepted Customer Terms yet.
  CUSTOMER_TERMS_PENDING
  /// CP §54, §85 — the beneficiary has a Recovery Outstanding; new cash payout waits.
  RECOVERY_OUTSTANDING
  /// CP §64 T23 — a corrected beneficiary waits while the old beneficiary's
  /// paid record on the same Booking is still to be recovered, unless MD approves.
  OLD_RECOVERY_PENDING
  /// CP §58 NT09 — staff or a declared close relative; waits for MD approval.
  STAFF_CONFLICT_REVIEW
  /// CP §55 NT08 — shares an indicator with an unresolved Recovery; waits for Accounts/MD.
  RECOVERY_CIRCUMVENTION_REVIEW
}

/// PRD §19.5 — Registered or Not Applicable satisfies the Member condition.
enum ReraStatus {
  REGISTERED
  PENDING
  EXPIRED
  NOT_APPLICABLE
}

enum BankStatus {
  PENDING
  VERIFIED
  SUPERSEDED
}

model CommissionRecord {
  id            String       @id @default(uuid())
  /// Sale commission hangs off the Booking; Buying Commission off the
  /// Acquisition. Exactly one is set (see constraints.sql).
  bookingId     String?
  booking       Booking?     @relation(fields: [bookingId], references: [id])
  acquisitionId String?
  acquisition   Acquisition? @relation(fields: [acquisitionId], references: [id])

  type                CommissionType
  beneficiaryRole     BeneficiaryRole
  beneficiaryPersonId String
  beneficiaryPerson   Person          @relation("CommissionBeneficiary", fields: [beneficiaryPersonId], references: [id])

  percent          Decimal @db.Decimal(7, 4)
  /// The rule and Project version the percentage came from (v2.1 §15).
  ruleVersion      String
  /// Verified Payment Received the record becomes eligible at: 25 or 100.
  milestonePercent Decimal @db.Decimal(7, 4)

  eligibility EligibilityState       @default(MILESTONE_PENDING)
  holdReason  CommissionHoldReason?
  payment     CommissionPaymentState @default(NOT_PAID)

  paidOn              DateTime?
  paidByRef           String?
  /// Compulsory for Paid Early (PRD §6.11).
  paymentRemarks      String?
  externalReferenceId String?            @unique
  externalReference   ExternalReference? @relation(fields: [externalReferenceId], references: [id])

  /// PRD §6.9 — old records are superseded, never deleted.
  externalProcessingCompleted Boolean           @default(false)
  isCurrent                   Boolean           @default(true)
  effectiveFrom               DateTime          @default(now())
  effectiveTo                 DateTime?
  closedReason                String?
  supersededById              String?           @unique
  supersededBy                CommissionRecord? @relation("CommissionSupersession", fields: [supersededById], references: [id])
  supersedes                  CommissionRecord? @relation("CommissionSupersession")

  /// v2.1 §21 — when the record reached its milestone (Payment Received or an
  /// Approved Buyback). Cleared if the milestone is lost. It is what counts a
  /// Customer-closing Loyalty event towards the lifetime three.
  qualifiedAt DateTime?

  /// AC-03 — Paid Early needs a recorded MD approval before Accounts may
  /// process it. Approver, timestamp and note are kept on the record itself so
  /// the approval can never be separated from the transaction it approved.
  earlyApprovedByRef          String?
  earlyApprovedAt             DateTime?
  earlyApprovalNote           String?
  /// CP §53 — Accounts initiates Paid Early with a compulsory reason; MD then
  /// approves or rejects. A rejection clears the request (history stays in the
  /// commission events and the audit trail).
  earlyRequestedByRef         String?
  earlyRequestedAt            DateTime?
  earlyRequestReason          String?
  /// CP §64 T23 — MD let this corrected beneficiary be paid before the old
  /// beneficiary's Recovery on the same Booking was resolved.
  beforeRecoveryApprovedByRef String?
  beforeRecoveryApprovedAt    DateTime?
  beforeRecoveryNote          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events     CommissionEvent[]
  recoveries Recovery[]        @relation("RecoverySource")
  setOffs    Recovery[]        @relation("RecoverySetOff")

  @@index([bookingId, isCurrent])
  @@index([beneficiaryPersonId, payment])
  @@index([eligibility, payment])
}

/// SSOT §22, §91; CP §54 — a paid monetary benefit that became invalid. The
/// amount stays outside the CRM; the CRM keeps the Accounts Recovery Reference,
/// the 15-day deadline and how it was cleared. While one is OUTSTANDING the
/// Person's new cash payouts are blocked.
enum RecoveryStatus {
  OUTSTANDING
  CLEARED
}

enum RecoveryClearance {
  /// The Person paid it back outside the CRM.
  REPAID
  /// Settled against a later monetary benefit of the same Person.
  SET_OFF
}

model Recovery {
  id                 String           @id @default(uuid())
  /// Display identity, e.g. REC-000012.
  recoveryNo         String           @unique
  personId           String
  person             Person           @relation(fields: [personId], references: [id])
  /// The paid benefit that became invalid.
  commissionRecordId String
  commissionRecord   CommissionRecord @relation("RecoverySource", fields: [commissionRecordId], references: [id])

  status    RecoveryStatus @default(OUTSTANDING)
  /// The day the Person was notified. Never in the future.
  noticeOn  DateTime
  /// noticeOn + 15 calendar days (SSOT §91).
  dueOn     DateTime
  /// The external Accounts Recovery Reference.
  reference String
  reason    String

  openedByRef String
  openedAt    DateTime @default(now())

  clearedHow     RecoveryClearance?
  clearedByRef   String?
  clearedAt      DateTime?
  clearNote      String?
  /// The later benefit it was set off against, when cleared by set-off.
  setOffRecordId String?
  setOffRecord   CommissionRecord?  @relation("RecoverySetOff", fields: [setOffRecordId], references: [id])

  circumventionReviews CircumventionReview[]

  @@index([personId, status])
  @@index([commissionRecordId])
}

/// CP §24, §41, §45 — which milestone qualified a non-cash reward.
enum RewardQualificationRoute {
  PAYMENT_100
  APPROVED_BUYBACK
}

/// SSOT §76, §77; Terms 6.2 §38 — a company-wide Royalty Gift Programme Version.
/// The catalogue lives outside the CRM; the CRM keeps the references, the
/// economics review (CP §7.4) and the approval. Same lifecycle as Project settings.
model RoyaltyProgrammeVersion {
  id               String                  @id @default(uuid())
  /// 1, 2, 3 … never reused.
  version          Int                     @unique
  status           CommissionVersionStatus @default(DRAFT)
  /// e.g. RGP-01 — the Programme Version name in the published Terms.
  programmeRef     String
  catalogueVersion String
  termsVersion     String
  reason           String

  preparedByRef          String
  preparedAt             DateTime  @default(now())
  submittedAt            DateTime?
  decidedByRef           String?
  decidedAt              DateTime?
  decisionNote           String?
  /// SSOT §101 — reviewed outside the CRM; only the fact, who and when are kept.
  economicsReviewedByRef String?
  economicsReviewedAt    DateTime?
  effectiveFrom          DateTime?
  effectiveTo            DateTime?

  bookings Booking[]
  credits  RoyaltyCredit[]
}

/// SSOT §75; CP §45 — one Royalty Credit = one catalogue Gift. No rate, no amount.
enum RoyaltyCreditState {
  ELIGIBLE
  SELECTED
  ORDERED
  DELIVERED
  REVERSED
}

/// CP §85; Terms doc 5 §88 — why non-cash fulfilment is held. A hold never
/// deletes the entitlement.
enum RewardHoldReason {
  RECOVERY_OUTSTANDING
  MEMBER_DEACTIVATED
  BUYBACK_STABLE_COMPLETION_PENDING
  REWARD_DEFICIENT
  NOMINEE_APPROVAL_PENDING
  PROGRAMME_TERMS_ACTION_REQUIRED
  STAFF_CONFLICT_REVIEW
  RECOVERY_CIRCUMVENTION_REVIEW
}

/// Terms doc 5 §6, §7 — who receives a non-cash reward. Immediate family needs
/// no approval; one non-family recipient needs MD.
enum RewardRecipient {
  SELF
  SPOUSE
  PARENT
  CHILD
  SIBLING
  NON_FAMILY
}

model RoyaltyCredit {
  id                 String                  @id @default(uuid())
  customerProfileId  String
  customerProfile    CustomerProfile         @relation(fields: [customerProfileId], references: [id])
  /// The Royalty Linked Member who owns it (SSOT §81).
  memberProfileId    String
  memberProfile      MemberProfile           @relation(fields: [memberProfileId], references: [id])
  /// The Club-direct repeat purchase that triggered it.
  triggerBookingId   String                  @unique
  triggerBooking     Booking                 @relation(fields: [triggerBookingId], references: [id])
  /// Frozen from the trigger Booking (SSOT §76).
  programmeVersionId String
  programmeVersion   RoyaltyProgrammeVersion @relation(fields: [programmeVersionId], references: [id])

  state              RoyaltyCreditState       @default(ELIGIBLE)
  qualificationRoute RewardQualificationRoute
  eligibleAt         DateTime                 @default(now())
  holdReason         RewardHoldReason?

  selectedRewardRef      String?
  selectedAt             DateTime?
  recipient              RewardRecipient?
  recipientName          String?
  recipientApprovedByRef String?
  recipientApprovedAt    DateTime?

  orderedAt         DateTime?
  orderReference    String?
  deliveredAt       DateTime?
  deliveryReference String?

  reversedAt     DateTime?
  reversalReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events RoyaltyCreditEvent[]

  @@index([memberProfileId, state])
  @@index([customerProfileId])
}

/// Append-only history of a Royalty Credit (CP §79).
model RoyaltyCreditEvent {
  id        String        @id @default(uuid())
  creditId  String
  credit    RoyaltyCredit @relation(fields: [creditId], references: [id])
  at        DateTime      @default(now())
  actorRef  String
  action    String
  fromState String?
  toState   String?
  reason    String?

  @@index([creditId, at])
}

/// SSOT §41, §49; CP §24 — a Trip Credit is a unit-based Own-Sale Credit or the
/// one lifetime Reference Credit an introduced Member gives their inviter.
enum TripCreditType {
  OWN_SALE
  REFERENCE
}

/// CP §24, §62.2 — never "Paid": Trip is non-cash.
enum TripCreditState {
  PENDING
  QUALIFIED
  ALLOCATED
  USED
  HELD
  REVERSED
  EXPIRED
}

enum TripBucketState {
  OPEN
  EARNED
  DEFICIENT
  CLOSED
  EXPIRED
}

enum TripRewardState {
  EARNED
  BOOKED
  TRAVELLED
  DEFICIENT
  CANCELLED
}

model TripCredit {
  id                 String                   @id @default(uuid())
  memberProfileId    String
  memberProfile      MemberProfile            @relation("TripCreditOwner", fields: [memberProfileId], references: [id])
  projectId          String
  /// CP §25.3 — the programme identity: Project + this code, across versions.
  programmeCode      String
  settingsVersionId  String
  settingsVersion    ProjectCommissionVersion @relation(fields: [settingsVersionId], references: [id])
  creditType         TripCreditType
  sourceBookingId    String
  sourceBooking      Booking                  @relation(fields: [sourceBookingId], references: [id])
  /// The unit the credit stands on — the parent's pool for a subdivided child (SSOT §44).
  creditPlotId       String
  /// Reference only: the directly introduced Member whose first sale it is.
  introducedMemberId String?
  introducedMember   MemberProfile?           @relation("TripCreditIntroduced", fields: [introducedMemberId], references: [id])

  state              TripCreditState
  qualificationRoute RewardQualificationRoute?
  pendingAt          DateTime?
  qualifiedAt        DateTime?
  expiresAt          DateTime?
  bucketId           String?
  bucket             TripBucket?               @relation(fields: [bucketId], references: [id])
  usedAt             DateTime?
  reversedAt         DateTime?
  reversalReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberProfileId, projectId, programmeCode, state])
  @@index([sourceBookingId])
  @@index([state, expiresAt])
}

/// SSOT §47; CP §31, §32 — opens on the Member's first Pending credit in a
/// programme and freezes the rules it will be judged by.
model TripBucket {
  id                  String                   @id @default(uuid())
  memberProfileId     String
  memberProfile       MemberProfile            @relation(fields: [memberProfileId], references: [id])
  projectId           String
  programmeCode       String
  settingsVersionId   String
  settingsVersion     ProjectCommissionVersion @relation(fields: [settingsVersionId], references: [id])
  totalTarget         Int
  minOwnCredits       Int
  maxReferenceCredits Int
  programmeVersionRef String
  termsVersionRef     String
  windDownAt          DateTime?
  openingCreditId     String?
  state               TripBucketState          @default(OPEN)
  openedAt            DateTime                 @default(now())
  earnedAt            DateTime?
  closedAt            DateTime?

  credits TripCredit[]
  reward  TripReward?

  @@index([memberProfileId, projectId, programmeCode, state])
}

/// CP §37 — an earned Trip and its fulfilment. No rupee value.
model TripReward {
  id              String            @id @default(uuid())
  bucketId        String            @unique
  bucket          TripBucket        @relation(fields: [bucketId], references: [id])
  memberProfileId String
  memberProfile   MemberProfile     @relation(fields: [memberProfileId], references: [id])
  state           TripRewardState   @default(EARNED)
  holdReason      RewardHoldReason?
  earnedAt        DateTime          @default(now())
  termsVersionRef String

  recipient              RewardRecipient?
  recipientName          String?
  recipientApprovedByRef String?
  recipientApprovedAt    DateTime?
  bookingReference       String?
  bookedAt               DateTime?
  travelledAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberProfileId, state])
}

/// Append-only Trip history — credits, buckets and rewards (CP §79).
model TripEvent {
  id              String   @id @default(uuid())
  memberProfileId String
  creditId        String?
  bucketId        String?
  rewardId        String?
  at              DateTime @default(now())
  actorRef        String
  action          String
  fromState       String?
  toState         String?
  reason          String?

  @@index([memberProfileId, at])
}

/// Append-only commission history for the record timeline (DESIGN §14.3).
model CommissionEvent {
  id        String           @id @default(uuid())
  recordId  String
  record    CommissionRecord @relation(fields: [recordId], references: [id])
  at        DateTime         @default(now())
  actorRef  String
  action    String
  fromState String?
  toState   String?
  reason    String?

  @@index([recordId, at])
}

/// PRD §14.4 — CRM enters, Accounts verifies, and the existing verified bank
/// stays active while new details are Pending. A replacement never puts every
/// Ready commission on hold by itself (PRD §14.3).
model BankDetail {
  id       String @id @default(uuid())
  personId String
  person   Person @relation(fields: [personId], references: [id])

  accountHolder     String
  bankName          String
  /// Which branch the account sits at — compulsory on every new entry. The
  /// column is nullable only because the rows written before it existed have
  /// no branch and nothing may invent one for them.
  branchName        String?
  /// Full account number is protected at rest; lists show the last four only.
  accountCipher     String
  accountLastFour   String
  ifsc              String
  /// CP §57; SSOT §94 — keyed blind index of the normalised account identity
  /// (bank code + account digits): one verified bank account = one Person.
  accountBlindIndex String?
  /// CP §57 — the proof of the joint holders, when a genuine joint account is
  /// shared with another Person. Verified only by a separate Accounts/MD decision.
  jointAccountProof String?

  status BankStatus @default(PENDING)

  enteredByRef  String
  verifiedByRef String?
  verifiedAt    DateTime?
  reason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId, status])
  @@index([accountBlindIndex])
}

/// CP §58; SSOT §95 — a defined close relative of staff (Terms 6.1 §202
/// "immediate family"): spouse, parent, child or sibling.
enum CloseRelation {
  SPOUSE
  PARENT
  CHILD
  SIBLING
}

/// CP §58 — the conflict disclosure: a staff Person's declared close relative.
/// Ended, never deleted.
model StaffRelative {
  id               String        @id @default(uuid())
  staffPersonId    String
  staffPerson      Person        @relation("StaffRelativeStaff", fields: [staffPersonId], references: [id])
  relativePersonId String
  relativePerson   Person        @relation("StaffRelativeRelative", fields: [relativePersonId], references: [id])
  relation         CloseRelation
  declaredByRef    String
  declaredAt       DateTime      @default(now())
  endedAt          DateTime?
  endedByRef       String?
  endReason        String?

  @@index([staffPersonId])
  @@index([relativePersonId])
}

/// CP §58, §65 NT09 — MD's decision on one benefit that a staff Person or a
/// declared close relative would receive. Until Approved the benefit is held.
model StaffConflictReview {
  id             String         @id @default(uuid())
  /// "Commission" | "Trip Reward" | "Royalty Credit" — the task record kinds.
  recordKind     String
  recordId       String
  personId       String
  person         Person         @relation(fields: [personId], references: [id])
  /// The staff Persons the conflict is with (the beneficiary themself, or whose relative they are).
  staffPersonIds String[]
  status         ReviewDecision @default(PENDING)
  raisedAt       DateTime       @default(now())
  decidedByRef   String?
  decidedAt      DateTime?
  decisionNote   String?

  @@unique([recordKind, recordId])
  @@index([personId, status])
}

/// CP §55 — which shared indicator links the subject to a Recovery Person.
enum CircumventionIndicator {
  BANK_ACCOUNT
  MOBILE
  ADDRESS
}

enum CircumventionStatus {
  PENDING_REVIEW
  CLEARED
  RESTRICTED
}

/// CP §55, §65 NT08; SSOT §92 — Recovery Circumvention Review. The subject is
/// never denied automatically; Accounts/MD clears or restricts with a reason.
model CircumventionReview {
  id              String                   @id @default(uuid())
  subjectPersonId String
  subjectPerson   Person                   @relation(fields: [subjectPersonId], references: [id])
  recoveryId      String
  recovery        Recovery                 @relation(fields: [recoveryId], references: [id])
  indicators      CircumventionIndicator[]
  status          CircumventionStatus      @default(PENDING_REVIEW)
  raisedAt        DateTime                 @default(now())
  decidedByRef    String?
  decidedAt       DateTime?
  reason          String?

  @@unique([subjectPersonId, recoveryId])
  @@index([status])
}

// ===========================================================================
// Phase 5 — Cancellation, Change Plot and Acquisition
// PRD §5, §11, §15; main-PRD §15, §16, §17.
// ===========================================================================

enum AcquisitionType {
  /// Previously sold by us and being taken back (main-PRD §17.1).
  BUYBACK
  /// New property from outside, bought to resell.
  PURCHASE_FOR_RESALE
}

enum AcquisitionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  /// PRD §11.4 — the Plot becomes Not Available — Deal Cancelled.
  CANCELLED
}

/// main-PRD §15 — the formal cancellation that follows an approved Booking.
/// The prior state is captured so a rejection restores it exactly.
model CancellationRequest {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  reason String
  remark String?

  /// The exact Booking, Plot and commission state before Refund Pending, so a
  /// rejection restores it rather than guessing (main-PRD §15.4).
  restoreSnapshot Json

  requestedByRef String
  requestedAt    DateTime @default(now())

  status       ReviewDecision @default(PENDING)
  decidedByRef String?
  decidedAt    DateTime?
  decisionNote String?

  /// PRD §15.4 — where payment exists the decision carries a reference and an
  /// action date. At 0% Accounts approves with No Payment Received.
  externalReferenceId String?            @unique
  externalReference   ExternalReference? @relation(fields: [externalReferenceId], references: [id])
  noPaymentReceived   Boolean            @default(false)

  @@index([bookingId, status])
}

/// PRD §5.3 — same Project only, same Booking Number, and the replacement PLC
/// snapshot is frozen at submission and only becomes permanent on approval.
model ChangePlotRequest {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  fromPlotId String
  fromPlot   Plot   @relation("ChangePlotFrom", fields: [fromPlotId], references: [id])
  toPlotId   String
  toPlot     Plot   @relation("ChangePlotTo", fields: [toPlotId], references: [id])

  remark         String
  requestedByRef String
  requestedAt    DateTime @default(now())

  /// Frozen at submission; discarded on rejection (PRD §5.3).
  replacementPlcSnapshotId String?
  replacementPlcSnapshot   PlcSnapshot? @relation(fields: [replacementPlcSnapshotId], references: [id])
  /// The Plot state to put back if the request is rejected.
  restoreSnapshot          Json

  /// PRD §5.3 — Accounts manually records the percentage applicable to the
  /// replacement Plot; no rupee conversion happens anywhere.
  appliedPercent Decimal? @db.Decimal(7, 4)

  status       ReviewDecision @default(PENDING)
  decidedByRef String?
  decidedAt    DateTime?
  decisionNote String?

  @@index([bookingId, status])
}

/// main-PRD §17 — Buyback and Purchase for Resale. Payment Given progress is a
/// percentage; no rupee value is stored anywhere.
model Acquisition {
  id            String            @id @default(uuid())
  acquisitionNo String            @unique
  type          AcquisitionType
  status        AcquisitionStatus @default(PENDING_APPROVAL)

  /// Set from the start for a Buyback; created on approval for a Purchase for
  /// Resale, when the property enters normal Plot Inventory (main-PRD §17.4).
  plotId               String?
  plot                 Plot?    @relation(fields: [plotId], references: [id])
  /// The Buyback's original Booking. Its history is never overwritten.
  sourceBookingId      String?
  sourceBooking        Booking? @relation("BuybackSource", fields: [sourceBookingId], references: [id])
  /// CR-016 — the source Booking's state at the moment an approved Buyback
  /// closed it, so an unwind restores it rather than guessing. Same shape and
  /// the same reason as CancellationRequest.restoreSnapshot (main-PRD §15.4):
  /// a derived guess cannot tell Booked from Payment Completed after the fact.
  sourceBookingRestore Json?

  sellerPersonId String
  sellerPerson   Person @relation("AcquisitionSeller", fields: [sellerPersonId], references: [id])

  arrangedByType     SoldByType
  arrangedByPersonId String?
  arrangedByPerson   Person?    @relation("AcquisitionArranger", fields: [arrangedByPersonId], references: [id])

  // External property details, for a Purchase for Resale (main-PRD §17.4).
  propertyName   String?
  location       String?
  projectType    ProjectType?
  propertyNumber String?
  areaSqFt       Decimal?     @db.Decimal(12, 4)
  plcPercent     Decimal?     @db.Decimal(7, 4)
  /// Normalised duplicate key across name, location and property number.
  duplicateKey   String?
  /// PRD §11.6 — the External Resale Property Group the property lands in.
  resaleGroupId  String?
  resaleGroup    Project?     @relation("ExternalResaleGroup", fields: [resaleGroupId], references: [id])

  purchaseDate DateTime
  remark       String

  /// Cumulative confirmed Payment Given. Never above 100%.
  paymentGivenPercent Decimal @default(0) @db.Decimal(7, 4)

  /// SSOT §61 — set at approval when the old sale had an Allotment or Registry,
  /// so the papers must come back before the Buyback is stable.
  documentsReturnRequired Boolean   @default(false)
  documentsReturnedAt     DateTime?
  documentsReturnedByRef  String?
  /// SSOT §61; CP §51 — Approved, Payment Given 100%, not unwound, documents
  /// back where required. Set when achieved, cleared when lost (audited).
  stableCompletedAt       DateTime?

  submittedByRef String
  submittedAt    DateTime  @default(now())
  decidedByRef   String?
  decidedAt      DateTime?
  decisionNote   String?
  closedReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleVersions PaymentScheduleVersion[]
  paymentEntries   PaymentGivenEntry[]
  commissions      CommissionRecord[]
  events           AcquisitionEvent[]

  @@index([status])
  @@index([duplicateKey])
}

/// PRD §1.2 — Payment Given is its own dataset, never merged with Payment
/// Received. The mechanics mirror it exactly (PRD §11.2).
model PaymentGivenEntry {
  id            String      @id @default(uuid())
  acquisitionId String
  acquisition   Acquisition @relation(fields: [acquisitionId], references: [id])

  percent    Decimal  @db.Decimal(7, 4)
  paidOn     DateTime
  recordedAt DateTime @default(now())

  externalReferenceId String            @unique
  externalReference   ExternalReference @relation(fields: [externalReferenceId], references: [id])

  /// [{ instalmentId, percent }] — oldest unpaid first.
  allocations Json

  status          EntryStatus        @default(CONFIRMED)
  correctsEntryId String?            @unique
  correctsEntry   PaymentGivenEntry? @relation("GivenCorrection", fields: [correctsEntryId], references: [id])
  correctedBy     PaymentGivenEntry? @relation("GivenCorrection")

  confirmedByRef String
  reason         String?
  remark         String?

  @@index([acquisitionId, status])
}

/// Append-only acquisition history for the record timeline.
model AcquisitionEvent {
  id            String      @id @default(uuid())
  acquisitionId String
  acquisition   Acquisition @relation(fields: [acquisitionId], references: [id])

  at         DateTime           @default(now())
  actorRef   String
  action     String
  fromStatus AcquisitionStatus?
  toStatus   AcquisitionStatus?
  detail     Json?
  reason     String?

  @@index([acquisitionId, at])
}

/// ARCHITECTURE §10 — jobs are idempotent, observable and catch up after downtime.
model ScheduledJobRun {
  id             String    @id @default(uuid())
  jobType        String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  /// Everything up to this instant has been processed by a successful run.
  cursorAt       DateTime?
  status         String    @default("RUNNING")
  processedCount Int       @default(0)
  changedCount   Int       @default(0)
  error          String?
  correlationId  String?

  @@index([jobType, startedAt])
}

// ===========================================================================
// Phase 6 — Allotment/Registry and Delivered, Reports and Exports,
//           Administration and Person Merge
// PRD §4, §17.2, §21, §22; main-PRD §18.
// ===========================================================================

/// PRD §4.1 — one route only. An Allotment-then-Registry third route needs an
/// approved change request and does not exist here.
enum CompletionRoute {
  ALLOTMENT
  REGISTRY
}

/// main-PRD §18.4 — Patta is Yes or Don't Know; there is no "No".
enum PattaStatus {
  YES
  DONT_KNOW
}

/// main-PRD §18.3–§18.7. One active row per Booking (partial unique index in
/// constraints.sql); an exceptional MD/Admin reopen sets `reopenedAt` and keeps
/// the row as history rather than deleting it.
model BookingCompletion {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  route CompletionRoute

  // Allotment route (main-PRD §18.4)
  allotmentDate    DateTime?
  allotmentNumber  String?
  allotmentGivenTo String?
  pattaStatus      PattaStatus?
  pattaDate        DateTime?

  // Registry route (main-PRD §18.5)
  advocateName String?
  registryDate DateTime?

  /// Set automatically with the completed route (PRD §4.4); never entered.
  papersLegallyTransferred Boolean  @default(true)
  deliveredAt              DateTime @default(now())
  completedByRef           String

  reopenedAt    DateTime?
  reopenedByRef String?
  reopenReason  String?

  createdAt DateTime @default(now())

  @@index([bookingId, reopenedAt])
}

/// PRD §21 — the export log stores report, filters, timestamp, user and row
/// count. The exported rows themselves are not retained.
model ExportLog {
  id          String   @id @default(uuid())
  at          DateTime @default(now())
  actorRef    String
  actorRole   String?
  report      String
  filters     Json
  rowCount    Int
  /// Optional integrity hash of the masked payload (PRD §21).
  contentHash String?

  @@index([at])
  @@index([report, at])
}

/// PRD §22 — merge needs MD approval, one surviving identity, and a Loyalty
/// count rebuilt from unique qualifying events rather than added or maximised.
model PersonMergeRequest {
  id                String @id @default(uuid())
  survivingPersonId String
  survivingPerson   Person @relation("MergeSurvivor", fields: [survivingPersonId], references: [id])
  mergedPersonId    String
  mergedPerson      Person @relation("MergeMerged", fields: [mergedPersonId], references: [id])

  status         ReviewDecision @default(PENDING)
  reason         String
  requestedByRef String
  requestedAt    DateTime       @default(now())
  decidedByRef   String?
  decidedAt      DateTime?
  decisionNote   String?

  /// CP §87 — the Customer-closing events rebuilt from unique valid events,
  /// capped at three. Repeat-purchase Loyalty is not counted here (unlimited).
  loyaltyRebuiltTo Int?

  @@index([status])
  @@index([survivingPersonId])
}

// ----------------------------------------------------------- Land Inquiry
/// Pre-acquisition land sourcing (Land Inquiry spec §1). It is not a Lead, a
/// Booking, a Plot or an Acquisition, and nothing here feeds Payment,
/// Commission or accounting: the rupee fields below are inquiry and
/// negotiation information only (spec §0 "Feature-specific exception").

/// Spec §2.2. Three sources are a Person already on file; Another Dealer is a
/// mobile number and nothing else — no Person row is created for it, ever.
enum LandInquiryReceivedFrom {
  MEMBER
  CUSTOMER
  THREE_PERCENT_CLUB
  ANOTHER_DEALER
}

/// Spec §20 — whether the inquiry is operationally open. Never overloaded to
/// carry acquisition progress; that is the Stage.
enum LandInquiryStatus {
  WORKING
  CLOSED
}

/// Spec §21, in displayed order.
enum LandInquiryStage {
  NEW
  DOCUMENTS_PENDING
  SITE_VISIT
  UNDER_VERIFICATION
  NEGOTIATION
  APPROVED_FOR_ACQUISITION
  REJECTED_CLOSED
}

enum LandCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  AGRICULTURAL
  OTHER
}

/// Spec §13 — one tracking vocabulary for all four approval fields. Internal
/// status only; never a guarantee of title, legality or future approval.
enum LandApprovalStatus {
  UNKNOWN
  NOT_APPLICABLE
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

/// Spec §14 — Unknown is a real answer and must never be stored as No.
enum LandCheckState {
  UNKNOWN
  YES
  NO
}

enum LandDevelopmentPotential {
  RESIDENTIAL
  COMMERCIAL
  WAREHOUSE
  AGRICULTURE
  OTHER
}

/// Spec §18 — "the inquiry record says this item was received". Not an upload,
/// not KYC, not a legal verification.
enum LandDocumentType {
  JAMABANDI
  REGISTRY
  MUTATION
  BHU_NAKSHA
  KHASRA_MAP
  CONVERSION_ORDER_90A
  PATTA
  OWNER_ID
  SITE_PHOTOS
  LOCATION_MAP
}

enum LandEvaluationType {
  SITE_VISIT_REQUIRED
  LEGAL_VERIFICATION_REQUIRED
  REVENUE_VERIFICATION_REQUIRED
}

/// Spec §16 — a rate with no basis is meaningless, so every rate carries one.
enum LandRateBasis {
  TOTAL
  PER_BIGHA
  PER_BISWA
  PER_HECTARE
  PER_SQ_M
  PER_SQ_FT
}

enum LinearUnit {
  FT
  MTR
}

/// Spec §11 — which metric unit the user actually typed, kept so the canonical
/// square metres can be shown back without conversion drift.
enum LandMetricSourceUnit {
  SQ_M
  HECTARE
  SQ_FT
}

model LandInquiry {
  id          String   @id @default(uuid())
  /// LI-000001, from the `land_inquiry_no_seq` sequence. Never a row count,
  /// never MAX+1, never editable (spec §6).
  inquiryNo   String   @unique
  /// The Asia/Kolkata calendar date the inquiry was taken, set by the server.
  /// `createdAt` keeps the full instant separately (spec §7).
  inquiryDate DateTime @db.Date

  receivedFrom        LandInquiryReceivedFrom
  /// Member and Customer name an existing Person. 3% Club is the company
  /// itself and names nobody; Another Dealer creates no Person and carries its
  /// own name and mobile on the inquiry.
  sourcePersonId      String?
  sourcePerson        Person?                 @relation("LandInquirySource", fields: [sourcePersonId], references: [id])
  /// Spec §2.2 — inquiry-local, deliberately not unique, and never an identity.
  anotherDealerMobile String?
  /// The dealer's name, as told on the call. Inquiry-local like the mobile: it
  /// creates, reuses and matches no Person, and two inquiries naming the same
  /// dealer are still two unrelated strings.
  anotherDealerName   String?

  status LandInquiryStatus @default(WORKING)
  stage  LandInquiryStage  @default(NEW)

  assignedToId String?
  assignedTo   StaffAccount? @relation("LandInquiryAssignee", fields: [assignedToId], references: [id])

  district      String?
  tehsil        String?
  exactLocation String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)

  /// Spec §11 — Bigha and Biswa are local measures with no statewide
  /// conversion, so they are stored exactly as entered and never derived from
  /// the metric area, nor it from them.
  areaBigha       Decimal?              @db.Decimal(20, 6)
  areaBiswa       Decimal?              @db.Decimal(20, 6)
  /// Canonical metric area. Hectare and Sq Ft are derived from it for display.
  areaSqM         Decimal?              @db.Decimal(20, 6)
  areaSourceUnit  LandMetricSourceUnit?
  areaSourceValue Decimal?              @db.Decimal(20, 6)

  frontageValue  Decimal?    @db.Decimal(18, 4)
  frontageUnit   LinearUnit?
  roadWidthValue Decimal?    @db.Decimal(18, 4)
  roadWidthUnit  LinearUnit?

  landCategory       LandCategory?
  currentLandUse     String?
  masterPlanZonalUse String?

  status90A            LandApprovalStatus @default(UNKNOWN)
  landConversionStatus LandApprovalStatus @default(UNKNOWN)
  changeLandUseStatus  LandApprovalStatus @default(UNKNOWN)
  pattaLeaseStatus     LandApprovalStatus @default(UNKNOWN)

  registrySaleDeedAvailable LandCheckState @default(UNKNOWN)
  mutationComplete          LandCheckState @default(UNKNOWN)
  /// Risk fields: YES means the issue exists or is reported (spec §14).
  mortgageBankCharge        LandCheckState @default(UNKNOWN)
  courtCaseStay             LandCheckState @default(UNKNOWN)
  familyDispute             LandCheckState @default(UNKNOWN)
  acquisitionNotice         LandCheckState @default(UNKNOWN)
  governmentRestriction     LandCheckState @default(UNKNOWN)

  approachRoad         LandCheckState @default(UNKNOWN)
  roadType             String?
  electricity          LandCheckState @default(UNKNOWN)
  water                LandCheckState @default(UNKNOWN)
  sewerage             LandCheckState @default(UNKNOWN)
  existingConstruction LandCheckState @default(UNKNOWN)
  encroachment         LandCheckState @default(UNKNOWN)
  possessionStatus     String?

  /// Spec §16 — INR, pre-acquisition only. Nothing here reaches a Booking, a
  /// Payment, a Commission, a payout, a refund or accounting.
  ownerAskingRate           Decimal?       @db.Decimal(20, 2)
  ownerAskingRateBasis      LandRateBasis?
  /// Stated by the seller and never recomputed from area x rate (spec §16).
  totalAskingValue          Decimal?       @db.Decimal(20, 2)
  negotiable                Boolean?
  dlcRate                   Decimal?       @db.Decimal(20, 2)
  dlcRateBasis              LandRateBasis?
  expectedPurchaseRate      Decimal?       @db.Decimal(20, 2)
  expectedPurchaseRateBasis LandRateBasis?
  paymentExpectation        String?

  developmentPotential LandDevelopmentPotential[] @default([])
  documentsReceived    LandDocumentType[]         @default([])
  evaluation           LandEvaluationType[]       @default([])

  /// The submission key. A retry with the same key returns the first result
  /// rather than creating a second inquiry (spec §26.6).
  createRequestId String @unique
  /// Optimistic lock. An update carrying a stale version is rejected, never
  /// merged (spec §26.7).
  version         Int    @default(1)

  createdByRef  String
  updatedByRef  String
  /// Spec §4.6 — no hard delete. Archiving hides the record from the default
  /// list and keeps every fact and every audit event.
  archivedAt    DateTime?
  archivedByRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owners           LandInquiryOwner[]
  jamabandiEntries LandInquiryJamabandiEntry[]

  @@index([inquiryDate])
  @@index([receivedFrom])
  @@index([status, stage])
  @@index([district, tehsil])
  @@index([sourcePersonId])
  @@index([assignedToId])
  @@index([archivedAt])
}

/// Spec §8 — owners are inquiry-child records. They are deliberately not
/// Person rows: a name heard on a phone call is not an identity the CRM holds.
model LandInquiryOwner {
  id            String      @id @default(uuid())
  landInquiryId String
  landInquiry   LandInquiry @relation(fields: [landInquiryId], references: [id], onDelete: Cascade)

  ownerName String
  mobile    String?
  isPrimary Boolean @default(false)
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([landInquiryId, sortOrder])
  @@index([ownerName])
  @@index([mobile])
}

/// Spec §10 — one inquiry can carry several revenue references. A row with all
/// three identifiers blank is not a record of anything and never persists.
model LandInquiryJamabandiEntry {
  id            String      @id @default(uuid())
  landInquiryId String
  landInquiry   LandInquiry @relation(fields: [landInquiryId], references: [id], onDelete: Cascade)

  murbbaNo  String?
  patharNo  String?
  khasraNo  String?
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([landInquiryId, sortOrder])
  @@index([khasraNo])
  @@index([patharNo])
}
