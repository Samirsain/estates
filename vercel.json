{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "functions": {
    "src/app/**/*": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/jobs?job=HOLD_EXPIRY", "schedule": "*/15 * * * *" },
    { "path": "/api/jobs?job=MEMBER_HOLD_REQUEST_EXPIRY", "schedule": "*/15 * * * *" },
    { "path": "/api/jobs?job=INSTALMENT_OVERDUE", "schedule": "30 19 * * *" },
    { "path": "/api/jobs?job=PAYMENT_RECEIVED_REMINDER", "schedule": "35 19 * * *" },
    { "path": "/api/jobs?job=PAYMENT_GIVEN_REMINDER", "schedule": "40 19 * * *" },
    { "path": "/api/jobs?job=BOOKING_DECISION_ALERT", "schedule": "45 19 * * *" },
    { "path": "/api/jobs?job=RERA_EXPIRY_REMINDER", "schedule": "50 19 * * *" },
    { "path": "/api/jobs?job=ANNUAL_COUNTER_RESET", "schedule": "55 19 * * *" }
  ]
}
