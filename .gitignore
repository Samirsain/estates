# dependencies
/node_modules
/.pnpm
/.yarn

# next.js
/.next/
/.next-check/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files. .env*, not .env and .env*.local: the names people
# actually make while editing one — .env.bak, .env.old, .env.production —
# fell through both rules, and this repository's .env holds the database
# credentials and the encryption keys.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Session log — contains live database credentials and MFA secrets in plain text.
# Keep it local; never commit it.
system/dd.md
*.log

# Local agent tooling and editor state — not part of the product.
.agents/
.claude/
.vscode/

# Screenshots dropped at the root to show something on screen. Assets the
# product ships live in public/.
/*.png
