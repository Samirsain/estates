# Copy to .env and fill in. .env is gitignored and must never be committed.

# Postgres. Both URLs are the Supabase pooler host; the port is the mode.
#
# 6543 is transaction mode and is the safe default: clients share the pool, and
# a process that is killed rather than closed frees its slot immediately.
#
# 5432 is session mode and is roughly three times faster on this project —
# measured ~100ms per query against ~350ms, and a page is several queries. It
# pins one pooler connection per client for the life of that client, so it needs
# headroom: the pool is 15 connections in total (Supabase dashboard → Database →
# Connection pooling → Pool size). Raise that well above 15 before switching, or
# a few restarts will exhaust it and every connection fails with EMAXCONNSESSION.
# Then use:
#   postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&connection_limit=5
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
# Schema changes need session mode; migrate deploy uses this one.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Session cookie signing key — at least 32 characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# AES-256-GCM key for Aadhaar, PAN and bank details at rest — 64 hex characters.
# (CR-003 removed multi-factor authentication; there is no MFA secret to encrypt.)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SENSITIVE_KEY=""

# Keyed blind index for duplicate Aadhaar/PAN detection — 64 hex characters.
# Changing this key invalidates every stored duplicate index; re-index if rotated.
BLIND_INDEX_KEY=""

# Shared secret for the POST /api/jobs scheduler endpoint.
JOBS_SECRET=""

# Interactive-transaction ceiling in milliseconds. The default (20000) suits a
# co-located database. A remote database with high round-trip latency needs more
# — a Booking submission runs ~25 statements in one transaction.
COMMAND_TIMEOUT_MS="20000"

# Set to "true" only when a trusted reverse proxy overwrites X-Forwarded-For.
# When unset, the header is ignored: it is client-supplied and must not become
# an audit fact or a shared rate-limit bucket.
TRUST_PROXY="false"

# Development and staging only. Check scripts write and delete tagged data;
# a production environment must never set this.
ALLOW_CHECK_WRITES="false"

# Forgot password — the shared recovery phrase, compared case-insensitively.
# Anyone who knows it can set a new password on any staff account, so change it
# here rather than in code, and change it whenever someone leaves.
RECOVERY_KEY="3preclub@2026fgpass"
