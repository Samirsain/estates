{
  "name": "three-percent-club-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "prisma generate",
    "build": "next build",
    "build:check": "node -e \"process.env.NEXT_DIST_DIR='.next-check';require('child_process').execFileSync('npx',['next','build'],{stdio:'inherit',shell:true})\"",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:constraints": "prisma db execute --file prisma/constraints.sql --schema prisma/schema.prisma",
    "db:seed": "node --env-file=.env prisma/seed.ts",
    "db:check": "node --env-file=.env prisma/db.check.ts && npm run booking:check && npm run commission:check && npm run phase5:check && npm run plc:check && npm run acquisition:check && npm run phase6:check && npm run phase7:check",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "check": "node --import ./prisma/alias-loader.mjs src/lib/tasks.check.ts && node --import ./prisma/alias-loader.mjs src/lib/security/security.check.ts && node --import ./prisma/alias-loader.mjs src/lib/domain/domain.check.ts && tsc --noEmit",
    "booking:check": "node --env-file=.env --import ./prisma/alias-loader.mjs prisma/booking.check.ts",
    "db:ping": "node --env-file=.env prisma/ping.ts",
    "demo": "node --env-file=.env --import ./prisma/alias-loader.mjs prisma/demo.ts",
    "commission:check": "node --env-file=.env --import ./prisma/alias-loader.mjs prisma/commission.check.ts",
    "plc:check": "node --env-file=.env --import ./prisma/alias-loader.mjs prisma/plc.check.ts",
    "phase5:check": "node --env-file=.env --import ./prisma/alias-loader.mjs prisma/phase5.check.ts",
    "phase6:check": "node --env-file=.env --import ./prisma/alias-loader.mjs prisma/phase6.check.ts",
    "phase7:check": "node --env-file=.env --import ./prisma/alias-loader.mjs prisma/phase7.check.ts",
    "acquisition:check": "node --env-file=.env --import ./prisma/alias-loader.mjs prisma/acquisition.check.ts",
    "reconcile": "node --env-file=.env --import ./prisma/alias-loader.mjs prisma/reconcile.ts",
    "rotate:key": "node --env-file=.env --import ./prisma/alias-loader.mjs prisma/rotate-key.ts",
    "reset:password": "node --env-file=.env --import ./prisma/alias-loader.mjs prisma/reset-password.ts",
    "jobs:run": "node --env-file=.env --import ./prisma/alias-loader.mjs prisma/run-jobs.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "next": "15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
